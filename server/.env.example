# 复制这个文件为 .env，然后填入你自己的 Key
# 去 https://console.anthropic.com 注册账号后创建 API Key
ANTHROPIC_API_KEY=your_api_key_here

# 去 https://turso.tech 注册账号，创建数据库后从控制台复制这两个值
# （或用命令行：turso db show <名字> --url  /  turso db tokens create <名字>）
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# 服务器端口，本地跑不用改
PORT=3001

# 用于给登录令牌签名，随便填一串足够长且随机的字符串，不要外泄
JWT_SECRET=change_this_to_a_long_random_string

# 内部数据统计页面(stats.html)的访问密钥，不设置的话统计功能会自动关闭
ADMIN_KEY=change_this_to_another_long_random_string

# OpenAI Whisper 语音识别（强烈建议配置）。浏览器自带识别几乎听不出芭蕾法语术语
# 去 https://platform.openai.com/api-keys 创建。模型默认 whisper-1，也可改成 gpt-4o-mini-transcribe
OPENAI_API_KEY=your_openai_api_key_here
# ASR_MODEL=whisper-1
# 问问档案：关键词命中 ≤1 时才调用。不配 OPENAI_API_KEY 则跳过，仍只用关键词
# ASK_EMBEDDING_MODEL=text-embedding-3-small

# 找回密码邮件（https://resend.com 免费额度即可）。线上不配则用户收不到信。
# 重置链接只会在 NODE_ENV=development|test、跑测试、或 EXPOSE_RESET_URL=1 时返回给请求方。
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=BalletMind <beth.t@example.com>
# 线上 Render 必须设 NODE_ENV=production（忘记密码才不会在没配邮件时把链接返回给请求方）
# NODE_ENV=production
# APP_PUBLIC_URL=https://balletmind-app.onrender.com

# 抽取模型。Sonnet 5 不要在请求里传 temperature（见 server/ai/anthropic.js）
# AI_MODEL=claude-sonnet-5

# 内部看板估算费用（美元）。DeepSeek 与 Anthropic 分开；Whisper 按每分钟。
# 若只把 DeepSeek 单价写在 ANTHROPIC_* 上（小于 $1/$2），代码会把它当 DeepSeek 价、Claude 仍用 2/10。
# 建议显式写两对：
# DEEPSEEK_INPUT_USD_PER_MTOK=0.28
# DEEPSEEK_OUTPUT_USD_PER_MTOK=0.42
# ANTHROPIC_INPUT_USD_PER_MTOK=2
# ANTHROPIC_OUTPUT_USD_PER_MTOK=10
# WHISPER_USD_PER_MIN=0.006

# 课前卡多 Agent 实验（分析→写作→审核）。两道闸都开才会跑；默认全关，所有用户仍是规则卡 0 LLM
# EXPERIMENT_ISSUE_BRIEF=0
# EXPERIMENT_ISSUE_BRIEF_USER_IDS=
# 逗号分隔的内部邮箱，Layer 3「真人」切片会排除这些账号（不回填、不改旧事件）
# ANALYTICS_INTERNAL_EMAILS=you@example.com

# --- Safety caps (all optional; defaults shown) ---
# Per-user daily AI calls (transcribe + generate): DAILY_AI_LIMIT=12
# Auth rate limits (per IP; login is per IP+email): RATE_LIMIT_LOGIN_MAX=10 (15 min),
# RATE_LIMIT_REGISTER_MAX=10 (1 h), RATE_LIMIT_FORGOT_MAX=5 (1 h), RATE_LIMIT_RESET_MAX=10 (15 min),
# RATE_LIMIT_DELETE_ACCOUNT_MAX=5 (15 min, per logged-in user)
# Uptime monitors can poll GET /api/health
# Backup JSON goes to ~/Documents/BalletMind-backups (override with BACKUP_DIR).
# Weekly dump on this Mac: `npm run backup:install-weekly` (Sunday 10:00, machine should be on).

# --- LLM provider (default: Anthropic, nothing to set) ---
# To use a domestic / OpenAI-compatible model instead, set all four:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.deepseek.com        (or the provider's compatible-mode URL, without /chat/completions)
# AI_MODEL=deepseek-chat
# AI_API_KEY=...
# If a provider cannot force a *named* tool, try: AI_FORCED_TOOL_CHOICE=required
# Compare candidates on the golden set without touching production:
#   AI_PROVIDER=openai-compatible AI_BASE_URL=... AI_MODEL=... AI_API_KEY=... npm run eval
# (also set EVAL_INPUT_USD_PER_MTOK / EVAL_OUTPUT_USD_PER_MTOK so the cost column is right)
# The stats page estimates DeepSeek / Anthropic / Whisper separately
# (DEEPSEEK_*_USD_PER_MTOK, ANTHROPIC_*_USD_PER_MTOK, WHISPER_USD_PER_MIN).
# Whisper (voice) still uses OPENAI_API_KEY regardless of this setting.
# Fallback (recommended when AI_PROVIDER=openai-compatible): if the primary fails with a timeout, network error,
# 5xx, 429, or a 401/402/403 (bad key / no balance), the same request is retried once on Anthropic.
# Needs ANTHROPIC_API_KEY. The primary's AI_MODEL is NOT used for the fallback:
# AI_FALLBACK_PROVIDER=anthropic
# AI_FALLBACK_MODEL=claude-sonnet-5
# Each fallback is logged as [ALERT][fallback] and counted in /api/health/ai as fallbackUses.

# --- Domestic ASR fallback (optional; Whisper stays primary) ---
# When Whisper fails (timeout, 5xx, bad key/balance), retry once on Tencent Cloud's
# "一句话识别" (SentenceRecognition). Off unless all of these are set:
# ASR_FALLBACK_PROVIDER=tencent
# ASR_FALLBACK_SECRET_ID=...       (Tencent Cloud console -> 访问管理 -> API密钥管理)
# ASR_FALLBACK_SECRET_KEY=...
# ASR_FALLBACK_REGION=ap-guangzhou (default; any region with ASR enabled works)
# ASR_FALLBACK_ENGINE=16k_zh-PY    (default; Mandarin + mixed English, closer to a ballet class)
# ASR_FALLBACK_HOTWORD_ID=...      (optional: a hotword table id from the Tencent Cloud ASR console,
#                                    e.g. containing pirouette/plié/tendu, for better term accuracy)
# BEFORE enabling in production: verify the signing code actually works against the real API —
#   cd server && ASR_FALLBACK_SECRET_ID=... ASR_FALLBACK_SECRET_KEY=... node scripts/test-tencent-asr.js <a-real-audio-file>
# There is no way to confirm this without real credentials; the automated tests only check the code's
# shape, not whether Tencent accepts the signature.
